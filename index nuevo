<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bat de Tali 2026</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Lora', serif; background: linear-gradient(135deg, #FAF6F1 0%, #F5EFEA 100%); min-height: 100vh; }
        .hidden { display: none !important; }
        .screen { width: 100%; min-height: 100vh; display: flex; flex-direction: column; background: linear-gradient(135deg, #FAF6F1 0%, #F5EFEA 100%); }
        .header { text-align: center; padding: 2rem 1rem; }
        .header h1 { font-size: 32px; font-weight: 300; color: #8B6F6F; letter-spacing: 2px; }
        .divider { width: 60px; height: 2px; background: linear-gradient(90deg, transparent, #C4846E, transparent); margin: 1.5rem auto; }
        .content { flex: 1; display: flex; justify-content: center; align-items: center; padding: 2rem; }
        .card { background: rgba(255, 250, 248, 0.95); border-radius: 12px; border: 1px solid #E8C4B8; padding: 2rem; box-shadow: 0 8px 32px rgba(196, 132, 110, 0.08); max-width: 600px; width: 100%; }
        .button-group { display: flex; gap: 16px; flex-direction: column; }
        button { padding: 14px 32px; border-radius: 8px; border: none; cursor: pointer; font-size: 16px; font-family: 'Lora', serif; transition: all 0.3s ease; }
        .btn-primary { background: linear-gradient(135deg, #C4846E 0%, #B8784C 100%); color: #FAF6F1; }
        .btn-primary:hover { transform: translateY(-2px); }
        .btn-secondary { background: transparent; border: 1.5px solid #C4846E; color: #8B6F6F; }
        .btn-back { background: none; border: none; color: #B8927A; text-decoration: underline; cursor: pointer; margin-bottom: 1.5rem; }
        input[type="text"] { width: 100%; padding: 14px; border-radius: 8px; border: 1px solid #E8C4B8; font-family: 'Lora', serif; margin-bottom: 1.5rem; }
        .file-input-wrapper { display: block; padding: 2.5rem; border-radius: 8px; border: 2px dashed #D4AFA0; text-align: center; cursor: pointer; background: rgba(196, 132, 110, 0.05); margin-bottom: 1.5rem; }
        .file-input-wrapper input { display: none; }
        .qr-section { text-align: center; background: rgba(196, 132, 110, 0.05); padding: 1.5rem; margin: 2rem 0; border-radius: 8px; }
        .qr-section img { max-width: 180px; margin: 1rem 0; border-radius: 8px; }
        .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; margin-top: 2rem; }
        .photo-item { position: relative; border-radius: 8px; overflow: hidden; aspect-ratio: 1; background: #F5EFEA; border: 1px solid #E8C4B8; }
        .photo-item img { width: 100%; height: 100%; object-fit: cover; }
        .status-badge { background: rgba(212, 174, 160, 0.1); border: 1px solid #D4AFA0; border-radius: 8px; padding: 1rem; margin: 2rem 0; text-align: center; color: #8B6F6F; }
        .status-badge.on { background: rgba(168, 184, 122, 0.1); border-color: #A8B87A; color: #7A8C52; }
        .btn-transmit { padding: 12px 24px; font-size: 14px; }
        .btn-transmit.on { background: linear-gradient(135deg, #D4746F 0%, #C45A55 100%); color: #FAF6F1; }
        .btn-transmit.off { background: linear-gradient(135deg, #A8B87A 0%, #95A56C 100%); color: #FAF6F1; }
        .container { padding: 2rem; max-width: 500px; margin: 0 auto; }
        .container-wide { padding: 2rem; max-width: 1000px; margin: 0 auto; }
        .empty-state { text-align: center; padding: 3rem 1rem; color: #B8927A; }
        #displayScreen { background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 100%); }
        .display-container { width: 100%; height: 100vh; display: flex; align-items: center; justify-content: center; position: relative; }
        .display-title { position: absolute; top: 40px; left: 40px; color: #C4846E; font-size: 28px; font-weight: 300; letter-spacing: 2px; }
        .display-counter { position: absolute; top: 40px; right: 40px; color: #C4846E; font-size: 24px; }
        .photo-main img { max-width: 100%; max-height: 100%; object-fit: contain; }
        .photo-info-display { position: absolute; bottom: 40px; left: 40px; color: #FAF6F1; }
        .photo-info-display .name { font-size: 32px; margin-bottom: 8px; }
        .display-empty { text-align: center; color: #B8927A; font-size: 32px; }
    </style>
</head>
<body>

<div id="mainScreen" class="screen">
    <div class="header"><h1>Bat de Tali</h1><div class="divider"></div><p style="color: #B8927A; font-style: italic;">2026</p></div>
    <div class="content">
        <div class="card">
            <p style="text-align: center; color: #8B6F6F; margin-bottom: 2rem;">Elige tu rol para continuar</p>
            <div class="button-group">
                <button class="btn-primary" id="btnGuest">📸 Soy un invitado</button>
                <button class="btn-secondary" id="btnOperator">🎥 Soy el operador</button>
            </div>
        </div>
    </div>
</div>

<div id="guestScreen" class="screen hidden">
    <div class="container">
        <button class="btn-back" id="btnBackGuest">← Volver</button>
        <div class="header"><h1>Compartir momento</h1><div class="divider"></div></div>
        <div class="card qr-section">
            <p style="color: #8B6F6F; font-size: 13px;">ESCANEA O COMPARTE</p>
            <img id="qrCode" alt="QR">
            <p style="font-size: 11px; color: #B8927A; word-break: break-all;" id="qrUrl"></p>
        </div>
        <div class="card">
            <label>Tu nombre</label>
            <input type="text" id="guestName" placeholder="Juan">
            <label class="file-input-wrapper">
                <input type="file" accept="image/*" id="fileInput">
                <div style="color: #8B6F6F;">
                    <div style="font-size: 24px;">📸</div>
                    Arrastra tu foto aquí<br><span style="font-size: 13px; color: #B8927A;">o haz clic</span>
                </div>
            </label>
            <div id="uploadCount" style="display: none; color: #8B6F6F; text-align: center; font-size: 13px;"></div>
        </div>
    </div>
</div>

<div id="operatorScreen" class="screen hidden">
    <div class="container-wide">
        <button class="btn-back" id="btnBackOp">← Salir</button>
        <div class="header"><h1>Panel de control</h1><div class="divider"></div></div>
        <div style="display: flex; gap: 1rem; margin-bottom: 2rem; align-items: center;">
            <span style="color: #8B6F6F; font-size: 13px; text-transform: uppercase;">Transmisión</span>
            <button id="btnTransmit" class="btn-transmit off">⚫ PAUSADO</button>
            <button id="btnDisplay" class="btn-secondary" style="margin-left: auto;">🖥️ Display</button>
        </div>
        <div id="statusBadge" class="status-badge">○ Transmisión pausada</div>
        <button id="btnClear" class="btn-secondary" style="border-color: #D4746F; color: #D4746F;">Borrar todo (<span id="photoCount">0</span>)</button>
        <div id="photoGrid" class="photo-grid">
            <div class="empty-state" style="grid-column: 1 / -1;">Esperando fotos...</div>
        </div>
    </div>
</div>

<div id="displayScreen" class="screen hidden">
    <div class="display-container">
        <div class="display-title">Bat de Tali</div>
        <div class="display-counter"><span id="displayCount">0</span> fotos</div>
        <div id="displayContent" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
            <div class="display-empty"><p>🎉</p><p>Esperando fotos...</p></div>
        </div>
    </div>
</div>

<script>
const SUPABASE_URL = 'https://vwmheggssodvqimppvcx.supabase.co';
const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ3bWhlZ2dzc29kdnFpbXBwdmN4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkzMjE3MDgsImV4cCI6MjEwNDg5NzcwOH0.W4L1bkVwzbO_b1juLgDeOm6OplOi40_cpQFNKaxOfHI';
const PASSWORD = 'operador2026';

const { createClient } = window.supabase;
const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

let photos = [];
let transmitting = false;
let currentIdx = 0;

async function loadPhotos() {
    const { data } = await supabase.from('photos').select('*').order('created_at', { ascending: false });
    photos = data || [];
    document.getElementById('photoCount').textContent = photos.length;
    document.getElementById('displayCount').textContent = photos.length;
    renderPhotos();
}

async function addPhoto(b64, name) {
    const now = new Date().toLocaleTimeString('es-AR');
    await supabase.from('photos').insert([{ name: name || 'Invitado', timestamp: now, src: b64 }]);
    await loadPhotos();
}

async function deletePhoto(id) {
    await supabase.from('photos').delete().eq('id', id);
    await loadPhotos();
}

async function clearAll() {
    if (confirm('¿Borrar todas?')) {
        await supabase.from('photos').delete().neq('id', 0);
        await loadPhotos();
    }
}

function renderPhotos() {
    const grid = document.getElementById('photoGrid');
    if (!photos.length) {
        grid.innerHTML = '<div class="empty-state" style="grid-column: 1 / -1;">Esperando fotos...</div>';
        return;
    }
    grid.innerHTML = photos.map(p => `
        <div class="photo-item" style="opacity: ${transmitting ? 1 : 0.6};">
            <img src="${p.src}" alt="Foto">
            <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0); display: flex; flex-direction: column; justify-content: space-between; padding: 8px;" class="overlay">
                <div style="color: #FAF6F1; font-size: 10px;">${p.timestamp}<br>${p.name}</div>
                <button style="background: rgba(0,0,0,0.6); color: white; border: none; border-radius: 4px; padding: 4px 8px; cursor: pointer; align-self: flex-end;" onclick="deletePhoto(${p.id})">✕</button>
            </div>
        </div>
    `).join('');
}

function updateDisplay() {
    const content = document.getElementById('displayContent');
    if (!transmitting || !photos.length) {
        content.innerHTML = '<div class="display-empty"><p>🎉</p><p>Esperando fotos...</p></div>';
        return;
    }
    if (currentIdx >= photos.length) currentIdx = 0;
    const p = photos[currentIdx];
    content.innerHTML = `
        <img src="${p.src}" style="max-width: 100%; max-height: 100%; object-fit: contain;">
        <div class="photo-info-display">
            <div class="name">${p.name}</div>
            <div style="font-size: 18px; opacity: 0.8;">${p.timestamp}</div>
        </div>
    `;
}

function showScreen(id) {
    document.getElementById('mainScreen').classList.add('hidden');
    document.getElementById('guestScreen').classList.add('hidden');
    document.getElementById('operatorScreen').classList.add('hidden');
    document.getElementById('displayScreen').classList.add('hidden');
    document.getElementById(id).classList.remove('hidden');
}

document.getElementById('btnGuest').onclick = () => {
    showScreen('guestScreen');
    document.getElementById('qrCode').src = 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=' + encodeURIComponent(window.location.href);
    document.getElementById('qrUrl').textContent = window.location.href;
};

document.getElementById('btnOperator').onclick = () => {
    const pwd = prompt('Contraseña:');
    if (pwd === PASSWORD) {
        showScreen('operatorScreen');
        loadPhotos();
    } else if (pwd !== null) alert('Incorrecta');
};

document.getElementById('btnBackGuest').onclick = () => showScreen('mainScreen');
document.getElementById('btnBackOp').onclick = () => showScreen('mainScreen');

document.getElementById('fileInput').onchange = async (e) => {
    const file = e.target.files[0];
    if (file) {
        const reader = new FileReader();
        reader.onload = async (evt) => {
            const name = document.getElementById('guestName').value || 'Invitado';
            await addPhoto(evt.target.result, name);
            document.getElementById('guestName').value = '';
            e.target.value = '';
            document.getElementById('uploadCount').style.display = 'block';
            document.getElementById('uploadCount').textContent = '✓ Foto compartida';
        };
        reader.readAsDataURL(file);
    }
};

document.getElementById('btnTransmit').onclick = () => {
    transmitting = !transmitting;
    const btn = document.getElementById('btnTransmit');
    const badge = document.getElementById('statusBadge');
    if (transmitting) {
        btn.textContent = '🔴 EN VIVO';
        btn.classList.remove('off');
        btn.classList.add('on');
        badge.textContent = '✓ Transmisión activa';
        badge.classList.add('on');
        setInterval(() => { if (transmitting && photos.length) { currentIdx = (currentIdx + 1) % photos.length; updateDisplay(); } }, 5000);
    } else {
        btn.textContent = '⚫ PAUSADO';
        btn.classList.add('off');
        btn.classList.remove('on');
        badge.textContent = '○ Transmisión pausada';
        badge.classList.remove('on');
    }
    renderPhotos();
    updateDisplay();
};

document.getElementById('btnDisplay').onclick = () => {
    showScreen('displayScreen');
    updateDisplay();
    setInterval(() => { loadPhotos(); if (transmitting && photos.length) updateDisplay(); }, 2000);
};

document.getElementById('btnClear').onclick = clearAll;

loadPhotos();
setInterval(loadPhotos, 2000);
</script>

</body>
</html>
